---
import devsync from '@core'
import { defaultLang } from '@core'
import { translations, type availableLangsType, getLangData } from '@core'

const lang = (Astro.params.lang || defaultLang).toLowerCase() as availableLangsType
const profile = getLangData(devsync, lang)
const translation = translations[lang]
const fullName = devsync.name ?? translation['UNKNOWN']
const dept = devsync.department ?? translation['NA']
const loc = devsync.location ?? translation['NA']
const uuid = [...fullName].reduce((a, c) => ((a << 5) - a + c.charCodeAt(0)) | 0, 0)
const uuidStr = (Math.abs(uuid) % 0xffffffff).toString(16).padStart(8, '0')
const fullUuid = `${uuidStr}-${uuidStr.slice(0, 4)}-4${uuidStr.slice(4, 7)}-a${uuidStr.slice(7, 10)}-${uuidStr}`
const socialIcons = devsync.socialMedia?.slice(0, 3) ?? []
---

<section class="about-section relative m-auto w-full max-w-4xl px-6 py-10">
  <div class="relative grid gap-6 lg:grid-cols-[3fr_2fr]">
    <div class="border-border bg-main relative h-fit overflow-hidden rounded-lg border">
      <div class="border-border flex items-center justify-between border-b px-4 py-2">
        <span class="text-accent font-mono text-xs font-bold tracking-wider uppercase">
          SUMMARY.TXT
        </span>
        <span class="text-text-secondary font-mono text-xs"> SIZE: 1.2KB </span>
      </div>

      <div class="p-5 font-mono text-sm">
        <div class="text-text-secondary mb-3">
          <span class="text-accent">$</span>
          <span class="ml-2">{translation['CAT_CMD']}</span>
        </div>

        <blockquote class="border-accent border-l-2 pl-4 not-italic">
          <p class="text-text-secondary leading-relaxed">
            {profile.description}
          </p>
        </blockquote>

        <div class="mt-4">
          <span class="animate-blink text-accent">$</span>
        </div>
      </div>
    </div>

    <div class="border-border bg-main relative hidden overflow-hidden rounded-lg border lg:block">
      <div class="flex flex-col items-center p-5">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 461" height="100" width="100"
          ><path
            fill="none"
            stroke="#467205"
            stroke-width="2"
            d="M284.3 228.59q.92-1.25 1.69-2.6c9.67-17.05 19.21-34.29 29.61-50.92q17.76-28.4 35.41-56.45a1.24 1.23 36.5 0 0-.25-1.6c-58.24-49.4-143.68-50.15-201.77.36a.59.59-36.8 0 0-.11.75q17.75 29.02 36.1 57.65 6.64 10.35 30.57 53.02a.89.89 0 0 1 0 .88c-10.59 18.66-21.01 37.56-32.42 55.73q-17.08 27.19-34.16 54.45a1.1 1.09-53.7 0 0 .21 1.41c56.89 49.61 144.33 49.95 201.33.26a1.56 1.56 53.6 0 0 .3-2q-16.79-26.85-33-52.58c-11.81-18.75-22.57-38.27-33.56-57.51a.79.78-41.8 0 1 .05-.85"
            vector-effect="non-scaling-stroke"></path><path
            d="M255.07 33.75c103.36 2.53 186.77 82.86 194.64 185.77q.77 9.95-.08 19.96c-9.89 116.95-112.19 199.04-229.02 183.16-92.76-12.61-162.77-90.83-170.25-182.9q-.82-10.06-.09-19.97c7.89-107.08 97.49-188.65 204.8-186.02m29.23 194.84q.92-1.25 1.69-2.6c9.67-17.05 19.21-34.29 29.61-50.92q17.76-28.4 35.41-56.45a1.24 1.23 36.5 0 0-.25-1.6c-58.24-49.4-143.68-50.15-201.77.36a.59.59-36.8 0 0-.11.75q17.75 29.02 36.1 57.65 6.64 10.35 30.57 53.02a.89.89 0 0 1 0 .88c-10.59 18.66-21.01 37.56-32.42 55.73q-17.08 27.19-34.16 54.45a1.1 1.09-53.7 0 0 .21 1.41c56.89 49.61 144.33 49.95 201.33.26a1.56 1.56 53.6 0 0 .3-2q-16.79-26.85-33-52.58c-11.81-18.75-22.57-38.27-33.56-57.51a.79.78-41.8 0 1 .05-.85"
          ></path><path
            fill="#8ce309"
            d="M284.25 229.44c10.99 19.24 21.75 38.76 33.56 57.51q16.21 25.73 33 52.58a1.56 1.56 53.6 0 1-.3 2c-57 49.69-144.44 49.35-201.33-.26a1.1 1.09-53.7 0 1-.21-1.41q17.08-27.26 34.16-54.45c11.41-18.17 21.83-37.07 32.42-55.73a.89.89 0 0 0 0-.88q-23.93-42.67-30.57-53.02-18.35-28.63-36.1-57.65a.59.59-36.8 0 1 .11-.75c58.09-50.51 143.53-49.76 201.77-.36a1.24 1.23 36.5 0 1 .25 1.6q-17.65 28.05-35.41 56.45c-10.4 16.63-19.94 33.87-29.61 50.92q-.77 1.35-1.69 2.6a.79.78-41.8 0 0-.05.85"
          ></path></svg
        >

        <div class="w-full space-y-2 font-mono text-xs">
          <div class="flex items-start gap-2">
            <span class="text-accent shrink-0 font-bold">{translation['NAME_LABEL']}:</span>
            <span class="text-text-secondary break-all">{fullName}</span>
          </div>
          <div class="flex items-start gap-2">
            <span class="text-accent shrink-0 font-bold">{translation['DEPT_LABEL']}:</span>
            <span class="text-text-secondary break-all">{dept}</span>
          </div>
          <div class="flex items-start gap-2">
            <span class="text-accent shrink-0 font-bold">{translation['LOC_LABEL']}:</span>
            <span class="text-text-secondary break-all">{loc}</span>
          </div>
          <div class="flex items-start gap-2">
            <span class="text-accent shrink-0 font-bold">{translation['UUID_LABEL']}:</span>
            <span class="text-text-secondary font-mono break-all">{fullUuid}</span>
          </div>
        </div>

        <div class="mt-5 flex items-center justify-center gap-4">
          {
            socialIcons.map((s) => (
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                class="border-border hover:border-accent hover:text-accent flex h-7 w-7 items-center justify-center rounded border transition-all duration-300"
              >
                <img src={s.icon} alt={s.name} class="h-3.5 w-3.5" />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.03) 2px,
      rgba(0, 0, 0, 0.03) 4px
    );
    pointer-events: none;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .animate-blink {
    animation: blink 1s step-end infinite;
  }
</style>
