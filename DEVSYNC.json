        "list": {
          "title": "Features",
          "items": [
            {
              "highlight": "Transparent proxy",
              "description": "Uses Bun.spawn with stdio: 'inherit' to connect Git streams directly to the terminal, preserving colors, interactive prompts, and the full native UX."
            },
            {
              "highlight": "Hexagonal architecture",
              "description": "Each command (add, commit, switch, setup) is organized into independent domain/app/infra layers, with interfaces as ports and Bun as the adapter."
            },
            {
              "highlight": "Interactive staging",
              "description": "g add without arguments opens a multiselect with @clack/prompts showing only modified files, automatically filtering .env and node_modules."
            },
            {
              "highlight": "Porcelain parsing",
              "description": "Parses git status --porcelain -z with NUL splitting for 100% reliable file detection across Git versions, system languages, and special characters."
            },
            {
              "highlight": "Interactive switch",
              "description": "g switch lists local and remote branches in a navigable selector, running checkout without needing to remember the exact branch name."
            },
            {
              "highlight": "Cross-platform alias",
              "description": "The setup command configures the g alias on Unix and Windows automatically, with separate infrastructure implementations per OS."
            }
